{
  "name": "truong-digital-classroom",
  "version": "1.0.0",
  "private": true,
  "description": "Hệ sinh thái học tập số môn Tin học THCS (Khối 6, 7, 8, 9): Quản lý lớp học, phiếu học tập điện tử, kiểm tra trực tuyến, tự động chấm điểm và gamification",
  "scripts": {
    "dev": "next dev -p 3000 -H 0.0.0.0",
    "build": "next build",
    "postbuild": "node -e \"const fs=require('fs');if(fs.existsSync('.next/standalone')){fs.cpSync('public','.next/standalone/public',{recursive:true,force:true});fs.cpSync('.next/static','.next/standalone/.next/static',{recursive:true,force:true});}\"",
    "start": "next start -p 3000 -H 0.0.0.0",
    "lint": "next lint"
  },
  "dependencies": {
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.49.1",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "motion": "^11.15.0",
    "next": "^14.2.24",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.24",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  }
}
